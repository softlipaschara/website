---
interface Props {
  variant?: 'black' | 'white';
  fallback?: string;
  label?: string;
}

const { variant = 'black', fallback = '/', label } = Astro.props;
---

<a
  class:list={['backButtonLink', { 'backButtonLink--text': Boolean(label) }]}
  href={fallback}
  data-back-button
  data-back-variant={variant}
>
  {
    label ? (
      <span class="backButtonText">{label}</span>
    ) : (
      <span class="backButton" role="img" aria-label="Back"></span>
    )
  }
</a>

<script>
  import '../scripts/back';
</script>
