---
import { homeNavigation } from '../data/site';
---

<div id="mask"></div>
<div id="header">
  <div>
    <ul id="navigation">
      {
        homeNavigation.map((item) => (
          <li id={item.id}>
            <span class:list={['title', item.id === 'indexButton' && 'btn btn-default']}>
              <a id={item.titleId} href={item.href}>{item.label}</a>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
